module parser

import core
import token
import ast

type Parser = {
    tokens: List<Token>,
    index: Int
}

fn parser(tokens: List<Token>) -> Parser {
    Parser {
        tokens: tokens,
        index: 0
    }
}

fn parser_token_at(
    tokens: List<Token>,
    wanted: Int,
    current: Int
) -> Option<Token> {

    match tokens {

        Nil => None,

        Cons(head,tail) =>
            match wanted == current {
                True => Some(head),
                False =>
                    parser_token_at(
                        tail,
                        wanted,
                        current + 1
                    )
            }
    }
}

fn parser_peek(p: Parser) -> Option<Token> {
    parser_token_at(
        p.tokens,
        p.index,
        0
    )
}

fn parser_advance(p: Parser) -> Parser {
    Parser {
        tokens: p.tokens,
        index: p.index + 1
    }
}

fn parser_skip_newlines(p: Parser) -> Parser {
    match parser_peek(p) {

        Some(t) =>
            match t.kind {
                Newline =>
                    parser_skip_newlines(
                        parser_advance(p)
                    ),
                _ => p
            },

        None => p
    }
}

fn parser_error(
    code: String,
    message: String,
    p: Parser
) -> Error {

    match parser_peek(p) {

        Some(t) =>
            Error {
                code: code,
                message: message,
                context:
                    string_concat(
                        int_to_string(t.span.start.line),
                        string_concat(
                            ":",
                            int_to_string(
                                t.span.start.column
                            )
                        )
                    )
            },

        None =>
            Error {
                code: code,
                message: message,
                context: "EOF"
            }
    }
}

fn expect_kind(
    p: Parser,
    kind: TokenKind
) -> Result<Pair<Parser,Token>,Error> {

    match parser_peek(p) {

        None =>
            Err(
                parser_error(
                    "PARSE_EOF",
                    "unexpected end of input",
                    p
                )
            ),

        Some(t) =>
            match t.kind == kind {

                True =>
                    Ok(Pair {
                        first: parser_advance(p),
                        second: t
                    }),

                False =>
                    Err(
                        parser_error(
                            "PARSE_EXPECTED_TOKEN",
                            string_concat(
                                "unexpected token: ",
                                t.lexeme
                            ),
                            p
                        )
                    )
            }
    }
}

fn parse_name(
    p: Parser
) -> Result<Pair<Parser,String>,Error> {

    match parser_peek(p) {

        Some(t) =>
            match t.kind {

                Identifier =>
                    Ok(Pair {
                        first: parser_advance(p),
                        second: t.lexeme
                    }),

                _ =>
                    Err(
                        parser_error(
                            "PARSE_EXPECTED_NAME",
                            "expected identifier",
                            p
                        )
                    )
            },

        None =>
            Err(
                parser_error(
                    "PARSE_EXPECTED_NAME",
                    "expected identifier",
                    p
                )
            )
    }
}

fn parse_system(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwSystem) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    Ok(Pair {
                        first: b.first,
                        second:
                            SystemStatement(
                                SystemDecl {
                                    name: b.second
                                }
                            )
                    })
            }
    }
}

fn parse_language(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwLanguage) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    Ok(Pair {
                        first: b.first,
                        second:
                            LanguageStatement(
                                LanguageDecl {
                                    name: b.second
                                }
                            )
                    })
            }
    }
}

