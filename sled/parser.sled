    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwOutput) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    Ok(Pair {
                        first: b.first,
                        second:
                            OutputStatement(
                                OutputDecl {
                                    name: b.second
                                }
                            )
                    })
            }
