    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwSource) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    Ok(Pair {
                        first: b.first,
                        second:
                            SourceStatement(
                                SourceDecl {
                                    name: b.second
                                }
                            )
                    })
