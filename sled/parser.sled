    match expect_kind(p0,KwTree) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    Ok(Pair {
                        first: b.first,
                        second:
                            TreeStatement(
