fn collect_names_until_keyword(
    p: Parser,
    acc: List<String>
) -> Pair<Parser,List<String>> {

    let q = parser_skip_newlines(p)

    match parser_peek(q) {

        None =>
            Pair {
                first: q,
                second: list_reverse(acc)
            },

        Some(t) =>
            match t.kind {

                Identifier =>
                    collect_names_until_keyword(
                        parser_advance(q),
                        Cons(t.lexeme,acc)
                    ),

                _ =>
                    Pair {
                        first: q,
                        second: list_reverse(acc)
                    }
            }
    }
}

fn parse_define(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwDefine) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    let collected =
                        collect_names_until_keyword(
                            b.first,
                            Nil
                        )

                    Ok(Pair {
                        first: collected.first,
                        second:
                            DefineStatement(
                                DefineBlock {
                                    name: b.second,
                                    values: collected.second
                                }
                            )
                    })
            }
    }
}

fn parse_map(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwMap) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    let q = parser_skip_newlines(b.first)

                    match expect_kind(q,KwTo) {

                        Err(e) => Err(e),

                        Ok(c) =>
                            let r =
                                parser_skip_newlines(c.first)

                            match parse_name(r) {

                                Err(e) => Err(e),

                                Ok(d) =>
                                    Ok(Pair {
                                        first: d.first,
                                        second:
                                            MapStatement(
                                                MapRule {
                                                    source: b.second,
                                                    target: d.second
                                                }
                                            )
                                    })
                            }
                    }
            }
    }
}

fn parse_invert(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwInvert) {

        Err(e) => Err(e),

        Ok(a) =>
            match parse_name(a.first) {

                Err(e) => Err(e),

                Ok(b) =>
                    let q = parser_skip_newlines(b.first)

                    match expect_kind(q,KwContains) {

                        Err(e) => Err(e),

                        Ok(c) =>
                            let r =
                                parser_skip_newlines(c.first)

                            match parse_name(r) {

                                Err(e) => Err(e),

                                Ok(d) =>
                                    Ok(Pair {
                                        first: d.first,
                                        second:
                                            InvertStatement(
                                                InvertRule {
                                                    parent: b.second,
                                                    child: d.second
                                                }
                                            )
                                    })
                            }
                    }
            }
    }
}

fn parse_emit(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwEmit) {

        Err(e) => Err(e),

        Ok(a) =>
            let collected =
                collect_names_until_keyword(
                    a.first,
                    Nil
                )

            Ok(Pair {
                first: collected.first,
                second:
                    EmitStatement(
                        EmitDecl {
                            values: collected.second
                        }
                    )
            })
    }
}

fn parse_end(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    match expect_kind(p0,KwEnd) {

        Err(e) => Err(e),

        Ok(a) =>
            match expect_kind(
                parser_skip_newlines(a.first),
                KwSystem
            ) {

                Err(e) => Err(e),

                Ok(b) =>
                    Ok(Pair {
                        first: b.first,
                        second: EndSystemStatement
                    })
            }
    }
}

fn parse_statement(
    p0: Parser
) -> Result<Pair<Parser,Statement>,Error> {

    let p = parser_skip_newlines(p0)

    match parser_peek(p) {

        None =>
            Err(
                parser_error(
                    "PARSE_EOF",
                    "unexpected EOF",
                    p
                )
            ),

        Some(t) =>
            match t.kind {

                KwSystem =>
                    parse_system(p),

                KwLanguage =>
                    parse_language(p),

                KwMode =>
                    parse_mode(p),

                KwSource =>
                    parse_source(p),

                KwTransform =>
                    parse_transform(p),

                KwTree =>
                    parse_tree(p),

                KwOutput =>
                    parse_output(p),

                KwDefine =>
                    parse_define(p),

                KwMap =>
                    parse_map(p),

                KwInvert =>
                    parse_invert(p),

                KwEmit =>
                    parse_emit(p),

                KwEnd =>
                    parse_end(p),

                _ =>
                    Err(
                        parser_error(
                            "PARSE_STATEMENT",
                            string_concat(
                                "invalid statement: ",
                                t.lexeme
                            ),
                            p
                        )
                    )
            }
    }
}

fn parse_program_loop(
    p0: Parser,
    acc: List<Statement>
) -> Result<Pair<Parser,Program>,Error> {

    let p = parser_skip_newlines(p0)

    match parser_peek(p) {

        None =>
            Ok(Pair {
                first: p,
                second:
                    program(
                        list_reverse(acc)
                    )
            }),

        Some(t) =>
            match t.kind {

                EndOfFile =>
                    Ok(Pair {
                        first: p,
                        second:
                            program(
                                list_reverse(acc)
                            )
                    }),

                _ =>
                    match parse_statement(p) {

                        Err(e) => Err(e),

                        Ok(parsed) =>
                            match parsed.second {

                                EndSystemStatement =>
                                    Ok(Pair {
                                        first: parsed.first,
                                        second:
                                            program(
                                                list_reverse(
                                                    Cons(
                                                        parsed.second,
                                                        acc
                                                    )
                                                )
                                            )
                                    }),

                                _ =>
                                    parse_program_loop(
                                        parsed.first,
                                        Cons(
                                            parsed.second,
                                            acc
                                        )
                                    )
                            }
                    }
            }
    }
}

fn parse(tokens: List<Token>)
    -> Result<Program,Error> {

    match parse_program_loop(
        parser(tokens),
        Nil
    ) {
        Err(e) => Err(e),
        Ok(result) => Ok(result.second)
    }
}
