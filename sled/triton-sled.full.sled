SYSTEM TRITON-SLED
LANGUAGE SLED
MODE STATIC_TRANSFORM
SOURCE MUSTACHE_XML
TRANSFORM XSLT
TREE INVERTED_XML
OUTPUT SLED
DEFINE PROJECT TRITON
DEFINE GRANT 101168103
DEFINE PROGRAMME EUROPEAN_DEFENCE_FUND
DEFINE TOPIC EDF-2023-RA-SI-CYBER-ASPT
DEFINE DURATION 36
DEFINE COORDINATOR UBITECH_LIMITED
DEFINE TYPE
    EU_DEFENCE_RESEARCH_ACTION
DEFINE NOT_TYPE
    COMMERCIAL_AGENT_PRODUCT
DEFINE PURPOSE
    GENERATIVE_AUTOMATION_OF_SECURITY_PENETRATION_TESTS
DEFINE GOALS
    AUTOMATE_PENTEST_LIFECYCLE
    AI_DRIVEN_SECURITY_ASSESSMENT
    THREAT_MODEL_CONSTRUCTION
    CONTINUOUS_DEVSECOPS_ASSESSMENT
    GENERATIVE_ATTACK_MODELING
    STOCHASTIC_DECISION_MODELING
    GAME_THEORETIC_RECOMMENDATION_OPTIMIZATION
    HUMAN_SUPERVISED_SECURITY_ANALYSIS
DEFINE CONCEPTS
    HaaSS = HUMAN_AS_A_SECURITY_SENSOR
    ACEE = ATTACK_CONFIGURATION_AND_EMULATION_ENGINE
    TAAG = THREAT_ASSET_ATTACK_VULNERABILITY_CONTROL_GRAPH
DEFINE PIPELINE
    PRE_ASSESSMENT
    RECONNAISSANCE
    THREAT_MODELING
    VULNERABILITY_CORRELATION
    PATH_MODELING
    CONTROLLED_EMULATION_MODEL
    RESULT_VALIDATION
    RISK_ANALYSIS
    RECOMMENDATION
    REPORT
DEFINE GRAPH
    THREAT
    ASSET
    ATTACK
    VULNERABILITY
    CONTROL
DEFINE KNOWLEDGE
    CPE
    CVE
    CWE
    NVD
DEFINE HUMAN_LAYER
    HUMAN_AS_SECURITY_SENSOR
DEFINE ENGINE
    ATTACK_CONFIGURATION_AND_EMULATION_ENGINE
DEFINE DECISION_MODEL
    STOCHASTIC_PROCESS
DEFINE OPTIMIZER
    GAME_THEORETIC_RECOMMENDATION
DEFINE CONTINUOUS_MODEL
    DEVSECOPS_SECURITY_ASSESSMENT
DEFINE DOMAINS
    MILITARY_SOC
    GOVERNMENT
    ENTERPRISE
    WEB
    CLOUD
    TELECOM
    WIRELESS
MAP OBSERVATION
TO EVIDENCE
MAP EVIDENCE
TO FINDING
MAP FINDING
TO RISK_MODEL
MAP RISK_MODEL
TO DECISION
MAP DECISION
TO RECOMMENDATION
MAP RECOMMENDATION
TO REPORT
INVERT REPORT
CONTAINS RECOMMENDATION
INVERT RECOMMENDATION
CONTAINS DECISION
INVERT DECISION
CONTAINS RISK_MODEL
INVERT RISK_MODEL
CONTAINS FINDING
INVERT FINDING
CONTAINS EVIDENCE
INVERT EVIDENCE
CONTAINS OBSERVATION
EMIT
    SYSTEM_MODEL
    PROJECT_MODEL
    ASSET_GRAPH
    THREAT_GRAPH
    VULNERABILITY_GRAPH
    RISK_MODEL
    DECISION_MODEL
    RECOMMENDATION_MODEL
    REPORT_MODEL
END SYSTEM
